---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Logo from '../components/Logo';
import Headline from '../components/Headline.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProofBar from '../components/ProofBar.astro';
import Card from '../components/Card.astro';
import CtaBand from '../components/CtaBand.astro';
import SpecTag from '../components/SpecTag.astro';
import SpecTable from '../components/SpecTable.astro';
import Gallery from '../components/Gallery';
import Faq from '../components/Faq.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import LogoStrip from '../components/LogoStrip.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import EnquiryForm from '../components/EnquiryForm';
import { forms } from '../data/forms';
import type { Vertical } from '../data/site';

// Raw values, mirrored from src/styles/global.css, for labels and the
// contrast check below.
const neutrals = [
  { token: 'paper', light: '#FFFFFF', dark: '#000000', use: 'Page background' },
  { token: 'concrete', light: '#E8E9E5', dark: '#1C1D1B', use: 'Alternate sections, panels' },
  { token: 'line', light: '#CFD1CC', dark: '#333532', use: 'Table rules, card edges' },
  { token: 'line-strong', light: '#7E817C', dark: '#8A8D88', use: 'Input borders' },
  { token: 'ink-muted', light: '#50534E', dark: '#B3B5B0', use: 'Captions, secondary text' },
  { token: 'ink', light: '#000000', dark: '#FFFFFF', use: 'Text, primary buttons' },
];

const accents: {
  vertical: Vertical;
  name: string;
  light: { fill: string; text: string; on: string };
  dark: { fill: string; text: string; on: string };
}[] = [
  { vertical: 'source', name: 'Source', light: { fill: '#2F3E9E', text: '#2F3E9E', on: '#FFFFFF' }, dark: { fill: '#8391EA', text: '#8391EA', on: '#000000' } },
  { vertical: 'build', name: 'Build', light: { fill: '#D9A21B', text: '#8A6410', on: '#000000' }, dark: { fill: '#E3B23C', text: '#E3B23C', on: '#000000' } },
  { vertical: 'minerals', name: 'Minerals', light: { fill: '#1F6F6B', text: '#1F6F6B', on: '#FFFFFF' }, dark: { fill: '#4FB3AC', text: '#4FB3AC', on: '#000000' } },
  { vertical: 'stone', name: 'Stone', light: { fill: '#A4553F', text: '#A4553F', on: '#FFFFFF' }, dark: { fill: '#DB8A6F', text: '#DB8A6F', on: '#000000' } },
];

function luminance(hex: string) {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}
function contrast(a: string, b: string) {
  const [x, y] = [luminance(a), luminance(b)].sort((m, n) => n - m);
  return (x + 0.05) / (y + 0.05);
}
const fmt = (n: number) => `${n.toFixed(1)}:1`;

const typeScale = [
  { cls: 't-hero', role: 'Hero headline', spec: 'Width 125, weight 700, clamp(48px, 7vw, 104px), line height 1.0', sample: 'Right material.' },
  { cls: 't-h1', role: 'H1', spec: 'Width 125, weight 700, 64px desktop, 40px mobile, line height 1.05', sample: 'Stone for every brief.' },
  { cls: 't-h2', role: 'H2', spec: 'Width 115, weight 650, 44px desktop, 30px mobile, line height 1.1', sample: 'What we supply.' },
  { cls: 't-h3', role: 'H3', spec: 'Width 100, weight 600, 26px desktop, 22px mobile, line height 1.2', sample: 'Masonry and blockwork' },
  { cls: 't-body', role: 'Body', spec: 'Width 100, weight 400, 18px desktop, 17px mobile, line height 1.55, at most 68 characters a line', sample: 'Procuro supplies construction materials, industrial minerals and stone, and runs managed sourcing for buyers who need verified Indian suppliers.' },
  { cls: 't-small', role: 'Small, captions', spec: 'Width 100, weight 400, 15px desktop, 14px mobile, line height 1.45', sample: 'A caption sits below its image in small sentence case.' },
  { cls: 't-button', role: 'Buttons, nav', spec: 'Width 100, weight 600, 15px, uppercase with 0.04em tracking', sample: 'Get a quote' },
  { cls: 't-spec', role: 'Spec values', spec: 'Width 100, weight 500, 16px, line height 1.4, tabular numbers', sample: 'PR-MN-T92 0123456789' },
];


const proof = [
  { figure: '2023', label: 'Supplying since' },
  { figure: '20+', label: 'Clients' },
  { figure: '30+', label: 'Real estate projects' },
  { figure: '1,50,000+', label: 'Sq ft of flooring and stone' },
];

const talcTable = {
  columns: ['Parameter', 'P92', 'I90', 'E85'],
  rows: [
    ['Brightness', '92.00', '90.40', '85.20'],
    ['Whiteness', '94.00', '91.80', '87.00'],
    ['Oil absorption (g/100 g)', '31.43', '35.52', '32.43'],
    ['SiO₂ (%)', '32.50', '55.20', '55.20'],
    ['CaO (%)', '16.27', '7.72', '8.68'],
    ['MgO (%)', '24.13', '28.12', '27.40'],
    ['pH', '8.4', '8.2', '8.4'],
  ],
};

const faqs = [
  { q: 'Which grades do you supply?', a: 'The P92, I90 and E85 talc grades, quicklime in two CaO grades, and custom talc grades on request.' },
  { q: 'Do you provide a certificate of analysis?', a: 'Yes, with every lot, as standard.' },
  { q: 'Are samples free?', a: 'Yes. You pay only for delivery.' },
];

const galleryImages = [
  { alt: 'Polished granite slabs in the yard' },
  { alt: 'Honed marble, close detail' },
  { alt: 'Sandstone pavers, flamed finish' },
  { alt: 'Slate tiles, natural cleft' },
  { alt: 'Limestone flooring, installed' },
  { alt: 'Stone cladding on a finished building' },
];

const sgHeading = 't-h2 mb-4';
const sgLead = 'measure mb-12 text-ink-muted';
---

<Base title="Styleguide · Procuro India" noindex>
  <Section>
    <div class="container-site">
      <h1 class="t-h1">Styleguide<span class="text-accent">.</span></h1>
      <p class="measure mt-6 text-ink-muted">
        The design system from <code>docs/DESIGN.md</code>, built as tokens and components. Not linked from the site
        and hidden from search engines.
      </p>
      <ul class="t-small mt-8 flex flex-wrap gap-x-6 gap-y-2">
        <li><a href="#colour" class="text-ink underline underline-offset-4">Colour</a></li>
        <li><a href="#type" class="text-ink underline underline-offset-4">Typography</a></li>
        <li><a href="#layout" class="text-ink underline underline-offset-4">Layout</a></li>
        <li><a href="#themes" class="text-ink underline underline-offset-4">Section themes</a></li>
        <li><a href="#buttons" class="text-ink underline underline-offset-4">Buttons</a></li>
        <li><a href="#logo" class="text-ink underline underline-offset-4">Logo</a></li>
        <li><a href="#chrome" class="text-ink underline underline-offset-4">Header, footer, WhatsApp</a></li>
        <li><a href="#components" class="text-ink underline underline-offset-4">Page components</a></li>
        <li><a href="#forms" class="text-ink underline underline-offset-4">Enquiry form</a></li>
      </ul>
    </div>
  </Section>

  <!-- Colour -->
  <Section surface="concrete" id="colour">
    <div class="container-site">
      <h2 class={sgHeading}>Colour<span class="text-accent">.</span></h2>
      <p class={sgLead}>Neutrals switch with the section theme. Black and white match the logo files exactly.</p>

      <div class="grid gap-6 md:grid-cols-2">
        {
          (['light', 'dark'] as const).map((theme) => (
            <div data-theme={theme} class="rounded-tag bg-paper p-6">
              <p class="t-h3 mb-6">{theme === 'light' ? 'Light theme' : 'Dark theme'}</p>
              <ul class="flex flex-col gap-3">
                {neutrals.map((n) => (
                  <li class="flex items-center gap-4">
                    <span
                      class="size-12 shrink-0 rounded-tag border border-line"
                      style={`background: var(--${n.token})`}
                    />
                    <span class="t-small">
                      <span class="block font-semibold">{n.token}</span>
                      <span class="t-spec text-ink-muted">{theme === 'light' ? n.light : n.dark}</span>
                      <span class="text-ink-muted">, {n.use}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <h3 class="t-h3 mt-20 mb-3">Vertical accents</h3>
      <p class="measure mb-8 text-ink-muted">
        One accent per page. Used on the headline full stop, links, vertical buttons, spec-tag header strips and the
        lockup full stop. Never as a section background or behind body text. Ratios are WCAG contrast; 4.5:1 is the
        floor for small text.
      </p>
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {
          accents.map((a) => (
            <div data-vertical={a.vertical} class="flex flex-col gap-4">
              {(['light', 'dark'] as const).map((theme) => {
                const v = a[theme];
                const paper = theme === 'light' ? '#FFFFFF' : '#000000';
                const concrete = theme === 'light' ? '#E8E9E5' : '#1C1D1B';
                const onPaper = contrast(v.text, paper);
                const onConcrete = contrast(v.text, concrete);
                const onFill = contrast(v.on, v.fill);
                return (
                  <div data-theme={theme} class="overflow-hidden rounded-tag bg-paper">
                    <div class="flex h-20 items-end bg-accent p-4 text-on-accent">
                      <span class="t-h3">{a.name}</span>
                    </div>
                    <dl class="t-small grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 p-4">
                      <dt class="text-ink-muted">Fill</dt>
                      <dd class="t-spec">{v.fill}</dd>
                      <dt class="text-ink-muted">Text</dt>
                      <dd class="t-spec text-accent-text">{v.text}</dd>
                      <dt class="text-ink-muted">Text on fill</dt>
                      <dd class="t-spec">{fmt(onFill)}</dd>
                      <dt class="text-ink-muted">Text on paper</dt>
                      <dd class="t-spec">{fmt(onPaper)}{onPaper < 4.5 && ' (large text only)'}</dd>
                      <dt class="text-ink-muted">Text on concrete</dt>
                      <dd class="t-spec">{fmt(onConcrete)}{onConcrete < 4.5 && ' (use ink for small text)'}</dd>
                    </dl>
                  </div>
                );
              })}
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Typography -->
  <Section id="type">
    <div class="container-site">
      <h2 class={sgHeading}>Typography<span class="text-accent">.</span></h2>
      <p class={sgLead}>One family, Archivo, with the width axis. Expanded for headlines, normal for everything else.</p>
      <div class="flex flex-col gap-12">
        {
          typeScale.map((t) => (
            <div class="grid-site gap-y-3">
              <div class="t-small col-span-12 text-ink-muted lg:col-span-3">
                <p class="font-semibold text-ink">{t.role}</p>
                <p>{t.spec}</p>
              </div>
              <p class:list={[t.cls, 'col-span-12 lg:col-span-9', t.cls === 't-body' && 'measure']}>
                {t.sample}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Layout -->
  <Section surface="concrete" id="layout">
    <div class="container-site">
      <h2 class={sgHeading}>Layout<span class="text-accent">.</span></h2>
      <p class={sgLead}>
        12 columns, 1360px maximum content width, 24px gutters (16px on mobile), 64px page margins on desktop. 128px
        between sections on desktop, 72px on mobile. Photos have square corners; buttons, inputs and spec tags have a
        3px radius. No shadows.
      </p>
      <div class="grid-site" aria-hidden="true">
        {Array.from({ length: 12 }, (_, i) => <div class="t-small flex h-24 items-end rounded-tag bg-paper p-2 text-ink-muted">{i + 1}</div>)}
      </div>
      <div class="grid-site mt-6 gap-y-6" aria-hidden="true">
        <div class="t-small col-span-12 rounded-tag bg-paper p-4 md:col-span-8">8 columns</div>
        <div class="t-small col-span-12 rounded-tag bg-paper p-4 md:col-span-4">4 columns</div>
        <div class="t-small col-span-12 rounded-tag bg-paper p-4 md:col-span-6">6 columns</div>
        <div class="t-small col-span-12 rounded-tag bg-paper p-4 md:col-span-6">6 columns</div>
      </div>
    </div>
  </Section>

  <!-- Section themes -->
  <div id="themes">
    {
      (
        [
          ['paper', 'Paper', 'The default light surface.'],
          ['concrete', 'Concrete', 'Alternate light surface, for panels and change of pace.'],
          ['dark', 'Black', 'Dark theme. Used for the footer, the stone gallery and the home hero band.'],
          ['dark-concrete', 'Dark concrete', 'Alternate dark surface.'],
        ] as const
      ).map(([surface, name, line]) => (
        <Section surface={surface}>
          <div class="container-site grid-site gap-y-6">
            <div class="col-span-12 lg:col-span-6">
              <h2 class="t-h2">{name}<span class="text-accent">.</span></h2>
              <p class="measure mt-4 text-ink-muted">{line}</p>
            </div>
            <div class="col-span-12 flex flex-wrap items-end gap-3 lg:col-span-6 lg:justify-end">
              <Button href="#themes">Get a quote</Button>
              <Button href="#themes" variant="secondary">See services</Button>
            </div>
          </div>
        </Section>
      ))
    }
  </div>

  <!-- Buttons -->
  <Section id="buttons">
    <div class="container-site">
      <h2 class={sgHeading}>Buttons<span class="text-accent">.</span></h2>
      <p class={sgLead}>
        Text only, uppercase, starting with a verb. Primary is an ink fill; vertical pages use the accent fill.
        Tab through them to see the focus ring.
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        {
          (['light', 'dark'] as const).map((theme) => (
            <div data-theme={theme} class="flex flex-col gap-8 rounded-tag bg-paper p-6 outline outline-1 outline-line">
              <div class="flex flex-wrap gap-3">
                <Button>Get a quote</Button>
                <Button variant="secondary">See all products</Button>
              </div>
              {accents.map((a) => (
                <div data-vertical={a.vertical} class="flex flex-wrap items-center gap-3">
                  <Button variant="accent">
                    {a.vertical === 'source' ? 'Send a brief' : a.vertical === 'build' ? 'Get a quote' : 'Request a sample'}
                  </Button>
                  <a href="#buttons" class="text-accent-text underline underline-offset-4">
                    {a.name} link
                  </a>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Logo -->
  <Section surface="concrete" id="logo">
    <div class="container-site">
      <h2 class={sgHeading}>Logo<span class="text-accent">.</span></h2>
      <p class={sgLead}>
        Traced from the supplied PNGs. Letters are always black or white; on vertical pages only the full stop takes the
        accent. Clear space is the height of the letter O on every side.
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        <div data-theme="light" class="flex h-48 min-w-0 items-center rounded-tag bg-paper px-6 text-ink sm:px-10">
          <Logo className="h-5 w-auto max-w-full sm:h-6" />
        </div>
        <div data-theme="dark" class="flex h-48 min-w-0 items-center rounded-tag bg-paper px-6 text-ink sm:px-10">
          <Logo className="h-5 w-auto max-w-full sm:h-6" />
        </div>
        {
          accents.map((a, i) => (
            <div
              data-theme={i % 2 ? 'dark' : 'light'}
              data-vertical={a.vertical}
              class="flex h-40 min-w-0 items-center rounded-tag bg-paper px-6 text-ink sm:px-10"
            >
              <Logo className="h-3.5 text-[17px] sm:h-5 sm:text-[24px]" lockup={a.name} accentStop />
            </div>
          ))
        }
      </div>
    </div>
  </Section>


  <!-- ============ Stage 2: page components ============ -->
  <Section surface="concrete" id="components">
    <div class="container-site">
      <h2 class="t-h1">Page components<span class="text-accent">.</span></h2>
      <p class="measure mt-6 text-ink-muted">
        The building blocks every page is made from. Copy below is sample text from the content files; figures marked
        to confirm are still waiting on the client.
      </p>
    </div>
  </Section>

  <Section>
    <div class="container-site flex flex-col gap-10">
      <h2 class={sgHeading}>Headline<span class="text-accent">.</span></h2>
      <p class="measure -mt-10 text-ink-muted">The final full stop takes the page's accent. Master pages use ink.</p>
      <Headline text="Right material. Right price. Right partner." as="p" size="h1" />
      {
        accents.map((a) => (
          <div data-vertical={a.vertical}>
            <Headline text={`${a.name} headline with an accent full stop.`} as="p" size="h2" />
          </div>
        ))
      }
    </div>
  </Section>

  <div class="bg-concrete pt-18 lg:pt-28" data-theme="light">
    <div class="container-site">
      <h2 class={sgHeading}>Hero: band<span class="text-accent">.</span></h2>
      <p class={sgLead}>Home page. Full-bleed photograph, black band, expanded headline. The full stop fades in last.</p>
    </div>
  </div>
  <Hero
    variant="band"
    headline="Right material. Right price. Right partner."
    line="Materials, minerals and sourcing from India, from one verified partner."
    image="Wide shot of the Jaipur yard with stone slabs"
    animateStop
  >
    <a href="#components" class="t-button inline-flex min-h-12 items-center rounded-tag bg-ink px-6 text-paper no-underline">
      Get a quote
    </a>
  </Hero>

  <div data-vertical="stone">
    <div class="bg-concrete pt-18 lg:pt-28" data-theme="light">
      <div class="container-site">
        <h2 class={sgHeading}>Hero: split<span class="text-accent">.</span></h2>
        <p class={sgLead}>Vertical and service pages. Shown here with the Stone accent.</p>
      </div>
    </div>
    <Hero
      variant="split"
      headline="Stone for every brief."
      line="Six families of natural stone and engineered surfaces, checked slab by slab."
      image="Stack of polished marble slabs"
    >
      <Button variant="accent" href="#components">Order samples</Button>
      <Button variant="secondary" href="#components">See all stone</Button>
    </Hero>
  </div>

  <Section surface="concrete">
    <div class="container-site">
      <SectionHeader
        layout="split"
        headline="Section header, split layout."
        line="Headline left, supporting line and an optional button right. Use for longer introductions."
        action={{ label: 'See services', href: '#components' }}
      />
      <SectionHeader
        headline="Section header, stacked layout."
        line="Headline over its line. The default."
      />
    </div>
  </Section>

  <Section surface="dark">
    <div class="container-site">
      <h2 class={sgHeading}>Proof bar<span class="text-accent">.</span></h2>
      <p class={sgLead}>Four figures, short labels. No counters or gradients. These figures are still to be confirmed.</p>
      <ProofBar items={proof} />
    </div>
  </Section>

  <Section>
    <div class="container-site">
      <h2 class={sgHeading}>Cards<span class="text-accent">.</span></h2>
      <p class={sgLead}>Photo, title, one line. The title underlines on hover; cards never lift or cast shadows.</p>
      <div class="grid grid-cols-1 gap-x-6 gap-y-14 md:grid-cols-3">
        <Card title="Build" vertical="build" href="#components" linkLabel="Explore Build" image="Blockwork going up on site" text="AAC blocks, mortar, plaster, tiles and surfaces, delivered to the drawing." />
        <Card title="Minerals" vertical="minerals" href="#components" linkLabel="Explore Minerals" image="Talc powder, close detail" text="Talc and quicklime, graded and documented lot by lot." />
        <Card title="Stone" vertical="stone" href="#components" linkLabel="Explore Stone" image="Polished granite slab edge" text="Six families of natural stone and engineered surfaces." />
      </div>
    </div>
  </Section>

  <Section surface="concrete">
    <div class="container-site grid-site gap-y-14">
      <div class="col-span-12 lg:col-span-5">
        <h2 class={sgHeading}>Spec tag<span class="text-accent">.</span></h2>
        <p class="measure text-ink-muted">
          Built like a Procuro lot label: the vertical's colour strip with the product name and code, then the values
          that matter. Used for talc grades, stones and Build materials.
        </p>
      </div>
      <div class="col-span-12 grid gap-6 sm:grid-cols-2 lg:col-span-7">
        <SpecTag
          vertical="minerals"
          name="Procuro Minerals"
          code="PR-MN-T92"
          rows={[
            { label: 'Material', value: 'Procuro Talc P92' },
            { label: 'Whiteness', value: '94.00' },
            { label: 'Mesh', value: '400' },
            { label: 'Certificate of analysis', value: 'Attached' },
            { label: 'Status', value: 'Verified' },
          ]}
          caption="Example tag"
        />
        <SpecTag
          vertical="stone"
          name="Procuro Stone"
          code="Granite"
          rows={[
            { label: 'Material', value: 'Absolute Black' },
            { label: 'Forms', value: 'Slabs, tiles' },
            { label: 'Finishes', value: 'Polished, honed' },
            { label: 'Status', value: 'Verified' },
          ]}
          caption="Example tag"
        />
      </div>
    </div>
  </Section>

  <Section>
    <div class="container-site">
      <h2 class={sgHeading}>Spec table<span class="text-accent">.</span></h2>
      <p class={sgLead}>Tabular figures, rules only inside the table. Scrolls sideways on narrow screens with the parameter column held in place.</p>
      <SpecTable
        caption="Full parameters"
        columns={talcTable.columns}
        rows={talcTable.rows}
        note="0 to 1,000 mesh. 40 kg PP or 1 MT HDPE bags. Custom grades built to your formulation."
      />
    </div>
  </Section>

  <Section surface="dark">
    <div class="container-site">
      <h2 class={sgHeading}>Gallery and lightbox<span class="text-accent">.</span></h2>
      <p class={sgLead}>Stone page, black theme. Select a photo to open it full screen; use the arrow keys or the buttons to move between photos.</p>
      <Gallery client:visible images={galleryImages} />
    </div>
  </Section>

  <Section>
    <div class="container-site grid-site gap-y-10">
      <div class="col-span-12 lg:col-span-4">
        <h2 class={sgHeading}>FAQ<span class="text-accent">.</span></h2>
        <p class="measure text-ink-muted">
          Accordion. Answers stay in the page so search engines and the browser's find can read them. Each FAQ block
          also outputs FAQPage structured data.
        </p>
      </div>
      <div class="col-span-12 lg:col-span-8">
        <Faq items={faqs} schema={false} />
      </div>
    </div>
  </Section>

  <Section surface="concrete">
    <div class="container-site">
      <h2 class={sgHeading}>Case study, quote, client logos<span class="text-accent">.</span></h2>
      <p class={sgLead}>Placeholders until the client supplies real case studies, a quote and logo permissions.</p>
      <div class="grid gap-6 md:grid-cols-2">
        <CaseStudyCard
          vertical="build"
          context="[TO CONFIRM: client type and city]"
          title="[TO CONFIRM: case study title]"
          problem="[TO CONFIRM: what the client needed and what was going wrong]"
          action="[TO CONFIRM: what Procuro supplied or arranged]"
          result="[TO CONFIRM: the measurable result]"
        />
        <CaseStudyCard
          vertical="source"
          context="[TO CONFIRM: international buyer, country]"
          title="[TO CONFIRM: case study title]"
          problem="[TO CONFIRM: what the buyer needed]"
          action="[TO CONFIRM: how Procuro Source found and verified suppliers]"
          result="[TO CONFIRM: the result]"
        />
      </div>
    </div>
  </Section>

  <Section>
    <div class="container-site flex flex-col gap-18 lg:gap-28">
      <QuoteBlock quote="[TO CONFIRM: one client quote]" name="[TO CONFIRM: name]" role="[TO CONFIRM: role, company]" />
      <LogoStrip logos={Array.from({ length: 6 }, () => ({ name: '[TO CONFIRM: client logo]' }))} />
    </div>
  </Section>

  <Section surface="concrete">
    <div class="container-site">
      <h2 class={sgHeading}>Image placeholder<span class="text-accent">.</span></h2>
      <p class={sgLead}>Stands in for a photo until a real or licensed one is chosen. The label says what the photo should show.</p>
      <div class="grid gap-6 md:grid-cols-3">
        <div data-theme="light" class="bg-paper p-4"><ImagePlaceholder label="Landscape, 4 by 3" ratio="4 / 3" /></div>
        <div data-theme="light" class="bg-paper p-4"><ImagePlaceholder label="Square" ratio="1 / 1" /></div>
        <div data-theme="light" class="bg-paper p-4"><ImagePlaceholder label="Portrait, 3 by 4" ratio="3 / 4" /></div>
      </div>
    </div>
  </Section>

  <CtaBand headline="Tell us what you need." line="Reply within one working day." surface="dark">
    <Button href="#components">Get a quote</Button>
  </CtaBand>

  <Section id="forms">
    <div class="container-site grid-site gap-y-10" data-vertical="build">
      <div class="col-span-12 lg:col-span-4">
        <h2 class={sgHeading}>Enquiry form<span class="text-accent">.</span></h2>
        <p class="measure text-ink-muted">
          Labels above inputs. Submit it empty to see the inline errors, which say how to fix each problem. Shown with
          the Build quote form. Nothing is sent yet; sending is wired in Stage 8.
        </p>
      </div>
      <div class="col-span-12 lg:col-span-8">
        <EnquiryForm client:visible form={forms.quote} showTitle />
      </div>
    </div>
  </Section>

  <!-- Header, footer, WhatsApp -->
  <Section id="chrome">
    <div class="container-site">
      <h2 class={sgHeading}>Header, footer, WhatsApp<span class="text-accent">.</span></h2>
      <div class="measure flex flex-col gap-4">
        <p>
          The header at the top of this page is the live component: logo left, four dropdowns and Why Procuro, GET A
          QUOTE on the right. It is sticky and gains a rule once the page scrolls. Below 1280px it collapses to a
          full-screen menu.
        </p>
        <p>The footer below is the live component on the black theme.</p>
        <p>
          The WhatsApp button floats bottom-right on phones and tablets, with a pre-filled message for each page.
          Elsewhere it appears inline:
        </p>
        <div><WhatsAppButton mode="inline" /></div>
      </div>
    </div>
  </Section>
</Base>
