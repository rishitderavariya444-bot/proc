---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { stubs, type Stub } from '../data/stubs';
import { site } from '../data/site';

export function getStaticPaths() {
  return stubs.map((stub) => ({ params: { stub: stub.path }, props: { stub } }));
}

const { stub } = Astro.props as { stub: Stub };
const isContact = stub.path === 'contact';
---

<Base title={`${stub.title} · Procuro India`} vertical={stub.vertical} noindex>
  <Hero variant="text" headline={stub.headline} line={stub.line}>
    {!isContact && <Button href="/contact" variant={stub.vertical ? 'accent' : 'primary'}>Get a quote</Button>}
    <WhatsAppButton mode="inline" />
  </Hero>
  <section class="bg-concrete py-12 lg:py-16">
    <div class="container-site t-small flex flex-col gap-2 text-ink-muted">
      <p>This page is being built. In the meantime, write to <a href={`mailto:${site.email}`} class="text-ink underline underline-offset-4">{site.email}</a> or call <a href={site.phoneHref} class="text-ink underline underline-offset-4">{site.phone}</a>.</p>
    </div>
  </section>
</Base>
