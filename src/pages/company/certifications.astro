---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Section from '../../components/Section.astro';
import Hero from '../../components/Hero.astro';
import Headline from '../../components/Headline.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { verifyByVertical } from '../../data/services';

// [TO CONFIRM] in docs/OPEN_ITEMS.md: registration numbers and any ISO or
// other certifications. Never fill these in without the client's documents.
const registrations = [
  { name: 'GST', label: 'Goods and Services Tax registration' },
  { name: 'IEC', label: 'Importer Exporter Code' },
  { name: 'CIN', label: 'Corporate Identification Number' },
  { name: 'Udyam', label: 'MSME registration' },
];
---

<Base
  title="Registrations and certifications · Procuro India"
  description="Registrations held by Deravariya India Private Limited, trading as Procuro India, and the documents that travel with every order."
>
  <Breadcrumbs items={[{ label: 'Company', href: '/company' }]} current="Certifications" />
  <Hero variant="text" headline="Registered and accountable." line={site.legalLine} />

  <Section surface="concrete">
    <div class="container-site grid-site gap-y-10">
      <div class="col-span-12 lg:col-span-5">
        <h2 class="t-h2">Registrations<span class="text-accent">.</span></h2>
        <p class="measure mt-5 text-ink-muted">Legal entity: {site.legalName}.</p>
      </div>
      <dl class="col-span-12 grid gap-x-6 sm:grid-cols-2 lg:col-span-7">
        {
          registrations.map((r) => (
            <div class="border-t border-line-strong py-5">
              <dt class="t-h3">{r.name}</dt>
              <dd class="t-small mt-1 text-ink-muted">{r.label}</dd>
              <dd class="t-spec mt-2">[TO CONFIRM: {r.name} number]</dd>
            </div>
          ))
        }
        <div class="border-t border-line-strong py-5 sm:col-span-2">
          <dt class="t-h3">Other certifications</dt>
          <dd class="t-spec mt-2">[TO CONFIRM: ISO or other certifications, if held]</dd>
        </div>
      </dl>
    </div>
  </Section>

  <Section>
    <div class="container-site">
      <Headline text="What travels with your order." class="mb-12 lg:mb-16" />
      <div class="grid gap-6 md:grid-cols-3">
        {
          verifyByVertical.map((v) => (
            <article data-vertical={v.vertical} class="flex flex-col gap-4 rounded-tag border border-line p-6 lg:p-8">
              <h3 class="t-h3">{v.name}<span class="text-accent">.</span></h3>
              <p class="t-small text-ink-muted">{v.text}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-10">
        <Button href="/services/quality-control" variant="secondary">See how we verify</Button>
      </div>
    </div>
  </Section>

  <CtaBand headline="Tell us what you need." line="Reply within one working day." surface="dark">
    <Button href="/contact">Get a quote</Button>
  </CtaBand>
</Base>
