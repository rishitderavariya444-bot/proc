---
import Base from '../layouts/Base.astro';
import logo from '../assets/logo-black.svg?raw';
---

<Base title="Procuro.">
  <main class="flex min-h-screen flex-col justify-center gap-6 px-6">
    <h1 class="sr-only">Procuro India</h1>
    <div class="w-full max-w-md" set:html={logo} />
    <p class="text-lg" style="font-stretch: 125%; font-weight: 700;">Site under construction.</p>
  </main>
</Base>
