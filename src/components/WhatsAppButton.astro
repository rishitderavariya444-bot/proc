---
import { whatsappGlyph } from '../data/whatsapp-glyph';
import { whatsappHref, whatsappMessages } from '../data/site';

interface Props {
  message?: string;
  /** "floating": fixed bottom-right on mobile. "inline": a normal button. */
  mode?: 'floating' | 'inline';
}
const { message = whatsappMessages.default, mode = 'floating' } = Astro.props;
const href = whatsappHref(message);
---

{
  mode === 'floating' ? (
    <a
      href={href}
      target="_blank"
      rel="noopener"
      aria-label="Chat with Procuro on WhatsApp (opens in a new tab)"
      class="fixed right-4 bottom-4 z-40 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-black lg:hidden"
    >
      <svg viewBox="0 0 24 24" class="size-7" aria-hidden="true">
        <path fill="currentColor" d={whatsappGlyph} />
      </svg>
    </a>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="noopener"
      class="t-button inline-flex min-h-12 items-center gap-3 rounded-tag border border-ink px-6 text-ink no-underline transition-colors hover:bg-ink hover:text-paper"
    >
      <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
        <path fill="currentColor" d={whatsappGlyph} />
      </svg>
      Chat on WhatsApp
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  )
}
