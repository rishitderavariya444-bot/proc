---
import Base from './Base.astro';
import Headline from '../components/Headline.astro';

interface Props {
  title: string;
  description: string;
  headline: string;
  sections: { heading: string; body: string }[];
}
const { title, description, headline, sections } = Astro.props;
---

<Base title={title} description={description}>
  <section class="bg-paper pt-12 pb-18 lg:pt-20 lg:pb-28">
    <div class="container-site grid-site gap-y-10">
      <div class="col-span-12 lg:col-span-4">
        <Headline text={headline} as="h1" size="h1" />
        <p class="t-small mt-6 text-ink-muted">Last updated: [TO CONFIRM: date, after legal review]</p>
      </div>
      <div class="col-span-12 flex flex-col lg:col-span-7 lg:col-start-6">
        {
          sections.map((s) => (
            <section class="border-t border-line py-7 first:border-t-0 first:pt-0">
              <h2 class="t-h3">{s.heading}</h2>
              <p class="measure mt-3 text-ink-muted">{s.body}</p>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>
