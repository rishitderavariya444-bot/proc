---
import '../styles/global.css';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site, whatsappMessages, type Vertical } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** The page's vertical; sets the accent colour. Omit on master pages. */
  vertical?: Vertical;
  /** Pre-filled WhatsApp message for this page (SITEMAP.md). */
  whatsappMessage?: string;
  /** Header floats transparently over a full-bleed hero. */
  headerOverlay?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Construction materials, industrial minerals and stone, plus managed procurement through Procuro Source. Offices in Mumbai and Jaipur.',
  vertical,
  whatsappMessage = vertical ? whatsappMessages[vertical] : whatsappMessages.default,
  headerOverlay = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
  </head>
  <body data-theme="light" data-vertical={vertical} class="min-h-screen antialiased">
    <Header
      client:load
      currentPath={Astro.url.pathname.replace(/\/$/, '') || '/'}
      overlay={headerOverlay}
      accentStop={!!vertical}
      whatsappMessage={whatsappMessage}
    />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer whatsappMessage={whatsappMessage} />
    <WhatsAppButton message={whatsappMessage} />
  </body>
</html>
